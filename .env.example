# ============================================================
# PUBLICAS. Vao para o bundle do frontend. Nunca coloque segredo aqui.
# ============================================================
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_publicavel
VITE_APP_URL=https://achilles-content.achillesmedia.com.br
VITE_DEMO_MODE=false

# ============================================================
# SERVIDOR. Somente Netlify Functions. Nunca prefixe com VITE_.
# ============================================================
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_chave_publicavel
SUPABASE_SECRET_KEY=sua_service_role_key

OPENAI_API_KEY=sua_chave_openai
OPENAI_TEXT_MODEL=configure_no_painel
OPENAI_IMAGE_MODEL=configure_no_painel

MP_ACCESS_TOKEN=seu_access_token
MP_WEBHOOK_SECRET=seu_webhook_secret

# URL publica do site. Usada no retorno do checkout, no webhook e no
# despacho interno para a Background Function. Sem ela o carrossel nao roda.
APP_URL=https://achilles-content.achillesmedia.com.br

# Segredo compartilhado entre as Functions. Gere uma string longa e aleatoria.
# Sem ela qualquer um poderia disparar a geracao de imagens.
INTERNAL_JOB_SECRET=troque_por_uma_string_longa_e_aleatoria
