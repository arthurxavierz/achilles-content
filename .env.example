# =====================================================================
# Achilles Content V5. Copie para .env e preencha.
# Em producao, estas variaveis vivem em Netlify > Site settings > Environment.
# Nunca comite o .env preenchido.
# =====================================================================

# ---- PUBLICAS, expostas no bundle do frontend --------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_publicavel_anon
VITE_APP_URL=https://achilles-content.achillesmedia.com.br
VITE_DEMO_MODE=false

# ---- SUPABASE, lado servidor -------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_chave_publicavel_anon
# Chave service_role. Da acesso total ao banco: so nas Netlify Functions.
SUPABASE_SECRET_KEY=sua_service_role_key

# ---- OPENAI -------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Modelo de texto: escreve a copy e monta a direcao de arte.
OPENAI_TEXT_MODEL=gpt-5.1
# Modelo de imagem. Isto aqui e so o ultimo recurso: o modelo de verdade
# vive em pricing.openai_model, uma faixa de preco por modelo
# (Padrao usa gpt-image-2.5-flare, Assinatura usa gpt-image-2.5-sunburst).
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Preco da OpenAI em dolar por milhao de tokens. Serve para calcular a
# margem real no painel. Confira a tabela vigente e ajuste se reajustarem.
OPENAI_TEXT_INPUT_USD_PER_M=1.25
OPENAI_TEXT_OUTPUT_USD_PER_M=10
OPENAI_IMAGE_INPUT_USD_PER_M=8
OPENAI_IMAGE_OUTPUT_USD_PER_M=30

# Teto de gasto do mes em dolar. Ao atingir, o sistema para de gerar mesmo
# com credito disponivel. Deixe 0 para desligar a trava. Configure tambem o
# limite de uso na propria conta OpenAI: sao duas camadas diferentes.
MONTHLY_API_CEILING_USD=300

# Cambio usado para converter custo de API em reais no painel admin.
USD_BRL_RATE=5.6

# ---- APLICACAO ----------------------------------------------------------
APP_URL=https://achilles-content.achillesmedia.com.br
# Segredo que autentica a chamada interna para a Background Function.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_JOB_SECRET=troque_por_uma_string_aleatoria_longa

# ---- PIX MANUAL ---------------------------------------------------------
# Chave PIX que recebe os pagamentos. CPF, CNPJ, e-mail, telefone ou aleatoria.
PIX_KEY=41988491690
# Nome do recebedor: ate 25 caracteres, sem acento (o sistema normaliza).
PIX_MERCHANT_NAME=ACHILLES MEDIA
# Cidade do recebedor: ate 15 caracteres.
PIX_MERCHANT_CITY=CURITIBA

# ---- MERCADO PAGO, opcional ---------------------------------------------
# Deixe em branco para operar somente com PIX manual.
# Se preencher, o checkout automatico volta a funcionar em paralelo.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
